%% Read WAV file
[x, Fs] = audioread('/MATLAB Drive/20220620T222500_4407951431142804_2.0.wav');

% If stereo, use first channel
if size(x,2) > 1
    x = x(:,1);
end

%% Calibration
HydrophoneSensitivity = -170;   % dB re 1 V/uPa
ClipVoltage = 0.79;             % V peak, gain setting 4
RecorderGain = 2.0;             % dB

Sensitivity_linear = 10^(HydrophoneSensitivity/20);

% WAV amplitude -> recorder voltage
V_ADC = x * ClipVoltage;

% Remove recorder gain
V_Hydrophone = V_ADC / 10^(RecorderGain/20);

% Voltage -> acoustic pressure
Pressure_uPa = V_Hydrophone / Sensitivity_linear;

% Time vector
t = (0:length(x)-1)/Fs;


%% TIME SERIES

figure('Position',[50 50 1200 800]);
tiledlayout(2,2,'TileSpacing','compact','Padding','compact');

nexttile;

plot(t,Pressure_uPa);

xlabel('Time (s)');
ylabel('Acoustic Pressure (\muPa)');
title('Calibrated Underwater Acoustic Signal');

grid on;
set(gca,'FontSize',12,'LineWidth',1.2);
xlim([0 t(end)]);


%% SPECTROGRAM

window = hamming(8192);
noverlap = 6144;
nfft = 16384;

[S,F,T,P] = spectrogram(V_Hydrophone,window,noverlap,nfft,Fs);

% Convert voltage PSD to pressure PSD
P_pressure = P/(Sensitivity_linear^2);

% Convert PSD to power in each frequency bin
df = Fs/nfft;
P_bin = P_pressure * df;

% Convert to dB re 1 uPa
P_dB = 10*log10(P_bin + eps);

nexttile;

imagesc(T,F/1000,P_dB);
axis xy;

% Show 0–22.05 kHz
ylim([0 22.05]);
yticks(0:2.5:22.5);

% Display 60 dB range
maxLevel = max(P_dB(:));
caxis([maxLevel-60 maxLevel]);

xlabel('Time (s)');
ylabel('Frequency (kHz)');
title('Calibrated Time-Frequency Spectrogram');

cb = colorbar;
cb.Label.String = 'Sound Pressure Level (dB re 1 \muPa)';
cb.Label.FontSize = 12;

colormap(turbo);

set(gca,'FontSize',12,'LineWidth',1.2);
xlim([0 t(end)]);


%% HISTOGRAM

nexttile([1 2]);

% Remove DC offset
Pressure_centered = Pressure_uPa - mean(Pressure_uPa);

% Find the central 99.9% of the data
lowerLimit = prctile(Pressure_centered,0.05);
upperLimit = prctile(Pressure_centered,99.95);

% Only use the central 99.9% for the displayed histogram
Pressure_hist = Pressure_centered( ...
    Pressure_centered >= lowerLimit & ...
    Pressure_centered <= upperLimit);

% Create histogram
histogram(Pressure_hist,100, ...
    'Normalization','probability');

% Logarithmic y-axis
set(gca,'YScale','log');

% Probability range
ylim([1e-6 1]);

% Focus on the central distribution
xlim([lowerLimit upperLimit]);

xlabel('Acoustic Pressure (\muPa)');
ylabel('Fraction of Samples');

title('Acoustic Pressure Distribution');

grid on;

set(gca,'FontSize',12,'LineWidth',1.2);
